#
# The RTL harness (3) as an AIG, for bounded checks and counterexample traces with ABC
# (e.g. yosys-abc -c "read ../build/muldiv/rtl_md_check.aig; strash; bmc3 -F 45"). Not used by make.
read_slang --top rtl_md_check -DSYNTHESIS -DYOSYS \
  -I ../../../vendor/lowrisc_ip/ip/prim/rtl \
  ../../../rtl/ibex_pkg.sv ../../../rtl/ibex_alu.sv ../../../rtl/ibex_multdiv_slow.sv \
  ../../../rtl/ibex_multdiv_fast.sv ../../../rtl/ibex_ex_block.sv \
  md_ref.sv rtl_md_check.sv --no-proc
proc
flatten
# Cut the three 17x17 multipliers of the single-cycle multiplier: their outputs become free
# values (an over-approximation). See rtl_md_check.sv.
select -assert-count 3 t:$mul
cutpoint t:$mul
opt_clean
setundef -undriven -anyseq
opt -full
wreduce
opt_clean
techmap
opt -fast
async2sync
dffunmap
aigmap
opt_clean
stat
write_aiger -zinit -map ../build/muldiv/rtl_md_check.aigmap ../build/muldiv/rtl_md_check.aig
